# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Get this from: Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional: enables AI refinement of why_it_matters/narrative/perspective text
# via OpenAI, and the /ai/chat ("Ask AI") endpoint. If not set, WIM/narrative/
# perspective all fall back to their rule-based text (no API call is made,
# no error); /ai/chat has no fallback and fails cleanly with a 500, which is
# why its UI entry point is currently removed from the mobile app (see
# docs/ENGINEERING.md's AI Pipeline section). Left unset in
# production as of that date to keep the app fully free to run.
# Get this from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional: protects POST /admin/generate-report with a simple API key check.
# If not set, the endpoint is open (acceptable for local development).
# If set, all requests must include the header: x-admin-key: <value>
# Use any strong random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=your-secret-admin-key-here

# Optional: enables the in-process report preparation scheduler.
# Set to "true" to start the scheduler automatically on server startup.
# Defaults to "false" — scheduler is off unless explicitly enabled.
ENABLE_SCHEDULER=false

# --- Daily mode (recommended for production) ---
# Run the pipeline at one or more fixed local times per day (Phase 34, added
# 2026-07-06 — was a single time before this). SCHEDULER_DAILY_TIME accepts
# a comma-separated list of "HH:MM" 24-hour times, e.g. "07:00,12:00,18:00" —
# a single value still works exactly as before. Each configured slot forces
# a full regenerate (perspective/watch-next/narrative/audio all produce a
# fresh version, not just a skip-if-already-ready), so users whose
# notification time is later in the day see content refreshed since the
# morning, not stale morning-only content.
# SCHEDULER_TIMEZONE must be a valid IANA timezone name.
# If SCHEDULER_DAILY_TIME is not set, the scheduler falls back to interval mode.
SCHEDULER_DAILY_TIME=07:00,12:00,18:00
SCHEDULER_TIMEZONE=America/Los_Angeles

# --- Interval mode (dev fallback) ---
# Used only when SCHEDULER_DAILY_TIME is NOT set.
# How often the scheduler runs (in seconds). Defaults to 60.
# Use a short value (e.g. 30) for rapid local testing.
SCHEDULER_INTERVAL_SECONDS=60

# --- Per-device scheduled push delivery (Phase 34) ---
# How often (in seconds) the background loop checks whether any device with
# a registered notification_time preference is due for its push. This loop
# always runs (independent of ENABLE_SCHEDULER) — it only delivers content
# already generated by the pipeline, at each device's own chosen local time.
# Defaults to 300 (5 min). Use a short value (e.g. 15) for local testing.
DEVICE_PUSH_TICK_SECONDS=300

# --- Google Sheets export (Phase 10C) ---
# Required for POST /admin/export/google-sheet.
# Service account JSON (preferred for deployment). Paste full JSON on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...@....iam.gserviceaccount.com",...}

# Alternative for local dev: path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Target spreadsheet ID (from sheet URL: .../d/<ID>/edit)
# GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Worksheet tab name (created if missing). Defaults to "Daily Briefings".
# GOOGLE_SHEET_TAB_NAME=Daily Briefings

# Share the spreadsheet with the service account client_email as Editor.

# --- Voice briefing / TTS (Phase 14.2) ---
# Narrative TTS uses the same OPENAI_API_KEY as WIM refinement when set.
# VOICE_TTS_PROVIDER=openai
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=nova
# VOICE_AUDIO_STORAGE=local
# VOICE_AUDIO_LOCAL_DIR=media/audio
# VOICE_AUDIO_PUBLIC_BASE_URL=http://127.0.0.1:8000/media/audio
# VOICE_TTS_MAX_CHARS=12000
# Opt-in scheduler hook after narrative generation (default false).
# ENABLE_VOICE_AUDIO_GENERATION=false

# Set VOICE_AUDIO_STORAGE=supabase on any host with an ephemeral filesystem
# (e.g. Render's standard Web Service) — local disk audio would otherwise be
# wiped on every redeploy, permanently breaking Archive/History voice
# playback for every past date with no auto-recovery. Requires:
# VOICE_AUDIO_STORAGE=supabase
# SUPABASE_SERVICE_ROLE_KEY=...   # Dashboard → Project Settings → API → service_role
# (SUPABASE_URL is already required above for auth; reused here too.)
# Bucket + public-read policy: migrations/0026_phase_39_audio_storage_bucket.sql

# --- RSS ingestion (Phase 15.1) ---
# Concurrent feed fetch tuning for POST /admin/run-pipeline ingest stage.
# Default raised 8→20 (2026-07-06 speed pass) — pure I/O fan-out over ~300
# distinct feed hosts; does not change which feeds are fetched/selected.
# INGESTION_MAX_CONCURRENCY=20
# INGESTION_FEED_TIMEOUT_SECONDS=10
# INGESTION_SLOW_SOURCE_THRESHOLD_SECONDS=5
# INGESTION_TOPIC_CONCURRENCY=4
# INGESTION_DB_BATCH_SIZE=100

# Article body scraping (app/ingestion/scrape.py) — for new records with no
# body_text from RSS (most feeds only provide a teaser summary), fetches the
# article's own URL and extracts the main text via trafilatura. The scraped
# text is never shown as full article text in the app (Read mode dropped
# that 2026-07-11) — as of 2026-07-13 it's used purely as internal raw
# material so improve_summary_from_body() can lengthen thin RSS summaries.
# Off by default here: extra per-article network fetch (~300 sources), some
# sites will fail/block/paywall, and re-publishing scraped full text may not
# be permitted by every source's terms of use — enable only after accepting
# that tradeoff. See the scraper notes in docs/ENGINEERING.md.
# ENABLE_ARTICLE_SCRAPING=false

# --- Archive retention (2026-07-11) ---
# Deletes daily_reports/articles/briefing_narratives/narrative audio files/
# editorial_perspectives/editorial_watch_next/generation_runs older than
# ARCHIVE_RETENTION_DAYS. Runs automatically once a day (see
# ARCHIVE_CLEANUP_TICK_SECONDS) and via POST /admin/archive-cleanup.
# Irreversible — see app/retention/service.py and docs/ENGINEERING.md's
# Operational Notes. saved_articles are never touched (independent copy).
# ARCHIVE_RETENTION_DAYS=7
# ARCHIVE_CLEANUP_TICK_SECONDS=86400

# product_events (analytics) has no other bound anywhere in the codebase —
# unlike the report-scoped tables above, it grows purely with user activity.
# Cleaned up by the same daily job, on its own longer window (2026-07-13).
# PRODUCT_EVENTS_RETENTION_DAYS=90

# --- AI platform (Phase 14.5) ---
# AI_PROVIDER=openai
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_CONNECT_TIMEOUT_SECONDS=10
# OPENAI_MAX_RETRIES=0
# OPENAI_DEBUG_MODEL=gpt-4.1-mini

# --- AI Intelligence Platform (Phase 22/23) ---
# Controls the /ai/chat streaming endpoint and the context builder.
#
# AI model routing (all default to gpt-4.1-mini unless set):
# AI_DEFAULT_MODEL=gpt-4.1-mini       # standard tasks (GENERAL, SUMMARIZE)
# AI_CHEAP_MODEL=gpt-4.1-mini         # low-cost tasks (fallback tier)
# AI_REASONING_MODEL=gpt-4o           # deep analysis (escalated by router)
# AI_TRANSLATION_MODEL=gpt-4.1-mini   # translation mode
#
# Context and generation limits:
# AI_MAX_CONTEXT_TOKENS=6000          # max tokens injected as context
# AI_MAX_RESPONSE_TOKENS=800          # max tokens for AI response
# AI_TEMPERATURE=0.3                  # generation temperature (0.0–1.0)
#
# Feature flags:
# AI_STREAMING_ENABLED=true           # set false to disable SSE streaming (debug)
#
# Debug mode (enables internal assertions in global graph, verbose logging):
# DEBUG=0

# --- WIM batch generation (Phase 16.1) ---
# Parallel topic workers during why_it_matters generation.
# Default raised 5→10 (2026-07-06 speed pass) — ~20 topics run in 2 waves
# instead of 4; one OpenAI batch call per topic, unaffected which articles
# get WIM text or the skip-if-already-present caching.
# WIM_TOPIC_CONCURRENCY=10

# --- Editorial Intelligence (Phase 17.1) ---
# Rule-based editorial profiling after assembly, before WIM.
# ENABLE_EDITORIAL_ENGINE=true

# --- Editorial Perspective (Phase 17.3) ---
# Optional AI polish for daily perspective (default off — rule-based only).
# ENABLE_PERSPECTIVE_AI_REFINE=false

# --- Watch Next aggregation (Phase 17.5) ---
# Rule-based daily watch list after perspective, before narrative.
# No extra env vars required.

# --- Authentication (Phase 18) — TEMPLATE ONLY ---
# Copy this file to .env and fill in values. Never commit .env.
# See docs/env-setup.md for setup instructions.
#
# Master auth switch. Default off — app and API behave like Phase 17.5.
ENABLE_AUTH=false
#
# Required only when ENABLE_AUTH=true (backend JWT verification for /auth/*).
# Supabase → Project Settings → API → Project URL
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#
# Required only when ENABLE_AUTH=true.
# Supabase → Project Settings → API → JWT Settings → Legacy JWT Secret
# (Used in Phase 18.2+ to verify Bearer tokens — not needed until then.)
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret-here

# --- RevenueCat entitlements (Phase 29) ---
# Required for POST /webhooks/revenuecat to accept requests (rejects with 503
# if unset — unlike ADMIN_API_KEY, this is never "open" by default).
# Set the exact same value as the webhook's "Authorization header" field in
# the RevenueCat dashboard (Project Settings → Integrations → Webhooks).
# REVENUECAT_WEBHOOK_SECRET=your-shared-webhook-secret-here

# --- Sentry crash/error monitoring (2026-07-09) ---
# Optional: if unset, sentry_sdk.init() is never called (no-op, same as
# every other optional integration in this file). Get the DSN from
# Sentry → your project → Settings → Client Keys (DSN).
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.us.sentry.io/xxxxx
# SENTRY_ENVIRONMENT=production
