# TEMPLATE ONLY — copy to .env and adjust for your environment.
# Never copy this file over an existing .env (you will lose local values).
# Never commit .env to version control.
# Restart Expo after changing values (npx expo start -c).
# See docs/env-setup.md for setup instructions.

# Simulator (default): http://127.0.0.1:8000
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.42:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Authentication (Phase 18) — default off ---
# Master auth switch. When false, no Supabase vars are required.
EXPO_PUBLIC_ENABLE_AUTH=false

# Required only when EXPO_PUBLIC_ENABLE_AUTH=true (Phase 18.1D+).
# Supabase → Project Settings → API → Project URL
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Required only when EXPO_PUBLIC_ENABLE_AUTH=true (Phase 18.1D+).
# Supabase → Project Settings → API → Project API keys → anon / publishable
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# --- Social sign-in (Phase 30, added 2026-07-05) ---
# Apple needs no env var here — it's configured via app.json's ios.usesAppleSignIn
# plus the Supabase dashboard (Authentication → Providers → Apple: Services ID,
# Team ID, Key ID, private key from your Apple Developer account).
#
# Google requires a "Web application" OAuth client from Google Cloud Console
# (APIs & Services → Credentials) — required by @react-native-google-signin even
# for native sign-in, since it's what lets the library request an ID token.
# Also add the same Client ID + its secret to Supabase (Authentication → Providers → Google).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
#
# Required on iOS specifically (the native module hard-requires this or a
# GoogleService-Info.plist — webClientId alone throws "failed to determine
# clientID"). Same Credentials page, "iOS" type client, Bundle ID
# com.whatsnews.app. Also requires app.json's google-signin plugin config
# to pass iosUrlScheme (see docs/ENGINEERING.md's Authentication section)
# — a native config change that needs a fresh
# EAS build to take effect.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# --- Sentry crash/error monitoring (2026-07-09) ---
# Optional: if unset, Sentry.init() is never called. Get the DSN from
# Sentry → your React Native project → Settings → Client Keys (DSN).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.us.sentry.io/xxxxx
